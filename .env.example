FIDELI_LLM_PROVIDER=openai_compat
FIDELI_LLM_API_KEY=sk-your-key
FIDELI_LLM_BASE_URL=https://api.deepseek.com/v1
FIDELI_LLM_MODEL=deepseek-flash

